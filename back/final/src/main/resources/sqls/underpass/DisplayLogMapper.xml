<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mbc.puf.underpass.dao.DisplayLogDao">

    <insert id="insertDisplayLog" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO display_log (underpass_id, message_type, operator_id)
        VALUES (#{underpassId}, #{messageType}, #{operatorId})
    </insert>

</mapper>
