# 카카오 JavaScript 키. 개발자 콘솔의 허용 도메인 등록 필요.
VITE_KAKAO_MAP_KEY=
# example: 첨부 HTML의 예시 데이터. 실제 인증/통제/푸시는 실행하지 않음.
# server: 실제 서비스 연결을 위한 구분값. API 규격은 아직 제공되지 않음.
VITE_DATA_MODE=example
# Server credentials. These are not exposed through import.meta.env.
KAKAO_REST_API_KEY=
KMA_SERVICE_KEY=
ITS_API_KEY=
