# 카카오 JavaScript 키. 개발자 콘솔의 허용 도메인 등록 필요.
VITE_KAKAO_MAP_KEY=
# example: 첨부 HTML의 예시 데이터. 실제 인증/통제/푸시는 실행하지 않음.
# server: 제공된 PUF 백엔드 API를 사용합니다.
VITE_DATA_MODE=server
# Server credentials. These are not exposed through import.meta.env.
KAKAO_REST_API_KEY=
KMA_SERVICE_KEY=
ITS_API_KEY=

# Spring Boot backend origin for the Vite /api proxy.
BACKEND_URL=http://localhost:5555

# Plate recognition server for the /control/plate proxy.
AI_SERVER_URL=http://localhost:8000
# Must match Spring puf.internal.api-key and the AI server internal key. Server only.
INTERNAL_API_KEY=
