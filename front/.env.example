# API 설정 안내: .env.local에 같은 항목이 있으면 .env보다 우선합니다. 변경 후 개발 서버를 재시작하세요.
# 카카오 JavaScript 키. 개발자 콘솔의 허용 도메인 등록 필요.
# [카카오 지도] JavaScript 키: 지도 표시, 장소 및 주소 검색에 사용합니다. 카카오 콘솔에 접속 도메인을 등록하세요.
VITE_KAKAO_MAP_KEY=
# example: 첨부 HTML의 예시 데이터. 실제 인증/통제/푸시는 실행하지 않음.
# server: 제공된 PUF 백엔드 API를 사용합니다.
# [데이터 모드] server: 실제 백엔드 연동 / example: 예시 데이터. API 키가 아닙니다.
VITE_DATA_MODE=server
# Server credentials. These are not exposed through import.meta.env.
# [카카오 길찾기·장소 검색] 본인 앱의 REST API 키. /api/navigation/directions, /api/navigation/places에서 서버가 사용합니다. VITE_를 붙이지 마세요.
KAKAO_REST_API_KEY=
# [기상청 날씨] 공공데이터포털 기상청 단기예보 서비스 인증키: 초단기실황(기온·습도·강수·풍속) 조회. /api/navigation/weather에서 서버가 사용합니다.
KMA_SERVICE_KEY=
# [ITS 도로 CCTV] 국가교통정보센터 발급 키: 주변 도로 CCTV 목록과 영상 URL 조회. /api/navigation/cctv에서 서버가 사용하며 시설 CCTV와는 별개입니다.
ITS_API_KEY=

# Spring Boot backend origin for the Vite /api proxy.
# [서비스 백엔드 주소] 일반 /api 요청을 전달할 Spring Boot 서버 주소. API 키가 아닙니다.
BACKEND_URL=http://localhost:5555

# ROUTEL AI 도우미: Gemini가 기본값입니다. 키에 VITE_를 붙이지 마세요.
CHAT_AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# OpenAI는 CHAT_AI_PROVIDER=openai로 직접 선택한 경우에만 사용합니다.
OPENAI_API_KEY=
# Responses API를 지원하는 모델. 필요하면 계정에서 사용 가능한 모델로 변경합니다.
OPENAI_MODEL=gpt-4.1-mini
